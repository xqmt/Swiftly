local function getCharacterCorners(char)
    local cf, size
    local ok = pcall(function()
        cf, size = char:GetBoundingBox()
    end)
    if not ok or not cf then return nil end
    local sx, sy, sz = size.X / 2, size.Y / 2, size.Z / 2
    local corners = table.create(8)
    for _, x in ipairs({-1, 1}) do
        for _, y in ipairs({-1, 1}) do
            for _, z in ipairs({-1, 1}) do
                corners[#corners + 1] = cf * Vector3.new(x * sx, y * sy, z * sz)
            end
        end
    end
    return corners
end

local function updateESP()
    local camera = workspace.CurrentCamera
    if not camera then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local data = espData[player]
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if not char or not char.Parent or not hum or hum.Health <= 0 then
                if data then
                    data.container.Visible = false
                    if data.highlight then
                        data.highlight.Enabled = false
                    end
                end
            else
                if not data then
                    data = createESP(player)
                end

                local color = getTeamColorFor(player)

                -- Create / update Highlight
                if not data.highlight or data.char ~= char then
                    if data.highlight then
                        data.highlight:Destroy()
                    end
                    local hl = Instance.new("Highlight")
                    hl.Name = "ESP_Highlight"
                    hl.Adornee = char
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillColor = color
                    hl.OutlineColor = color
                    hl.FillTransparency = 0.75
                    hl.OutlineTransparency = 0.45
                    hl.Parent = ScreenGui
                    data.highlight = hl
                    data.char = char
                else
                    data.highlight.Adornee = char
                    data.highlight.FillColor = color
                    data.highlight.OutlineColor = color
                    data.highlight.Enabled = true
                end

                -- Compute on-screen bounding box for UI labels
                local corners = getCharacterCorners(char)
                local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
                local anyOnScreen = false
                if corners then
                    for _, c in ipairs(corners) do
                        local sp, onScreen = camera:WorldToViewportPoint(c)
                        if sp.Z > 0 then
                            anyOnScreen = true
                            if sp.X < minX then minX = sp.X end
                            if sp.Y < minY then minY = sp.Y end
                            if sp.X > maxX then maxX = sp.X end
                            if sp.Y > maxY then maxY = sp.Y end
                        end
                    end
                end

                if anyOnScreen then
                    local vs = camera.ViewportSize
                    minX = math.clamp(minX, -vs.X, vs.X * 2)
                    minY = math.clamp(minY, -vs.Y, vs.Y * 2)
                    maxX = math.clamp(maxX, -vs.X, vs.X * 2)
                    maxY = math.clamp(maxY, -vs.Y, vs.Y * 2)

                    local w = maxX - minX
                    local h = maxY - minY

                    data.container.Position = UDim2.fromOffset(minX, minY)
                    data.container.Size = UDim2.fromOffset(w, h)
                    data.container.Visible = true

                    data.name.TextColor3 = color
                    data.name.Text = (player.Team and player.Team.Name) or player.Name

                    local hp = math.max(0, math.floor(hum.Health))
                    local maxHp = math.max(1, math.floor(hum.MaxHealth))
                    data.health.Text = string.format("%d / %d", hp, maxHp)

                    local ratio = hp / maxHp
                    local hcolor
                    if ratio > 0.6 then
                        hcolor = Color3.fromRGB(80, 255, 120)
                    elseif ratio > 0.3 then
                        hcolor = Color3.fromRGB(255, 200, 60)
                    else
                        hcolor = Color3.fromRGB(255, 70, 70)
                    end
                    data.health.TextColor3 = hcolor
                else
                    data.container.Visible = false
                end
            end
        end
    end
end

