local function findCastRay()
    if filtergc then
        local ok, result = pcall(filtergc, "function", {Name = "castRay"}, true)
        if ok and result then return result end
    end
    if getgc then
        local ok, gc = pcall(getgc, false)
        if ok and gc then
            local debugInfo = debug and (debug.info or debug.getinfo)
            if debugInfo then
                for _, obj in ipairs(gc) do
                    if type(obj) == "function" then
                        local s, src = pcall(debugInfo, obj, "s")
                        if s then
                            local source = type(src) == "string" and src or (type(src) == "table" and (src.source or src.short_src)) or nil
                            if source and source:find("castRay") then
                                return obj
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function castRayHandler(startPos, targetPos, ...)
    if not CFG.enabled then return origCastRay(startPos, targetPos, ...) end
    local closest, closestPos = getClosest(CFG.fov)
    if not closest then return origCastRay(startPos, targetPos, ...) end
    local gun = State.currentGun
    local isTaser = gun and gun:GetAttribute("Projectile") == "Taser"
    local isShotgun = gun and gun:GetAttribute("IsShotgun")
    if CFG.hitchanceAutoOnly and isShotgun then
        return origCastRay(startPos, targetPos, ...)
    end
    local targetPart, aimPos = getAimTarget(closest)
    aimPos = aimPos or closestPos
    if CFG.velocitylead and aimPos and targetPart and targetPart:IsA("BasePart") then
        local ping = (LocalPlayer.GetNetworkPing and LocalPlayer:GetNetworkPing()) or 0.08
        aimPos = aimPos + targetPart.AssemblyLinearVelocity * ping * (tonumber(CFG.velocityleadfactor) or 0.15)
    end
    if CFG.shotgungamehandled and isShotgun then
        return origCastRay(startPos, aimPos or targetPos, ...)
    end
    local shouldHit
    if CFG.taseralwayshit and isTaser then shouldHit = true
    elseif CFG.ifplayerstill and isStanding(closest) then shouldHit = true
    else shouldHit = rollHit() end
    if shouldHit then
        if targetPart and aimPos then
            if CFG.shotgunnaturalspread and isShotgun then
                return origCastRay(startPos, aimPos, ...)
            end
            if CFG.wallbang then
                local newOrigin, hit = wallbangResolve(startPos, aimPos, targetPart)
                if newOrigin then
                    wallbangPending = {origin = newOrigin, hit = hit, part = targetPart, t = os.clock()}
                    return targetPart, hit or aimPos
                end
            end
            return targetPart, aimPos
        end
    else
        if aimPos then
            return origCastRay(startPos, getMissPos(aimPos), ...)
        end
    end
    return origCastRay(startPos, targetPos, ...)
end

local function setupCastRayHook()
    if castRayHooked or not hookfunction then return false end
    local fn = findCastRay()
    if not fn then return false end
    local ok, result = pcall(hookfunction, fn, safeWrap(castRayHandler))
    if not ok or type(result) ~= "function" then return false end
    origCastRay = result
    castRayHooked = true
    return true
end

