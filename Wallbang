-- ======================= UI updater =======================
local lastUITarget = nil
local lastUITargetUpdate = 0
local lastWallbangCheck = 0
local canManipulateNow = false

local function updateUITarget()
    local now = os.clock()
    if now - lastUITargetUpdate < 0.05 then return lastUITarget end
    lastUITargetUpdate = now
    local t = getClosest(CFG.fov)
    lastUITarget = t
    return t
end

local function updateManipulationText()
    local now = os.clock()
    if now - lastWallbangCheck < 0.2 then return canManipulateNow end
    lastWallbangCheck = now
    canManipulateNow = false
    if not CFG.enabled or not CFG.wallbang then return false end
    local target = updateUITarget()
    if not target then return false end
    local myChar = LocalPlayer.Character
    local myHead = myChar and myChar:FindFirstChild("Head")
    if not myHead then return false end
    local targetPart, targetPos = getAimTarget(target)
    if not targetPart or not targetPos then return false end
    if not wallBetween(myHead.Position, targetPos, target.Character) then return false end
    local ok, newOrigin = pcall(wallbangResolve, myHead.Position, targetPos, targetPart)
    if ok and newOrigin then
        canManipulateNow = true
    end
    return canManipulateNow
end

RunService.RenderStepped:Connect(function()
    refreshManipulationStatus()
    refreshFovCircle()

    local camera = workspace.CurrentCamera
    if not camera then return end
    local vs = camera.ViewportSize
    local center = Vector2.new(vs.X / 2, vs.Y / 2)

    -- Target line to locked target's head
    local target = updateUITarget()
    if target and target.Character then
        local headPart = getTargetPart(target.Character)
        if headPart then
            local sp, onScreen = camera:WorldToViewportPoint(headPart.Position)
            if onScreen and sp.Z > 0 then
                local targetScreen = Vector2.new(sp.X, sp.Y)
                local delta = targetScreen - center
                local dist = delta.Magnitude
                if dist > 1 then
                    local mid = (center + targetScreen) / 2
                    local angle = math.deg(math.atan2(delta.Y, delta.X))
                    targetLine.Size = UDim2.new(0, dist, 0, 1)
                    targetLine.Position = UDim2.new(0, mid.X, 0, mid.Y)
                    targetLine.Rotation = angle
                    targetLine.Visible = true
                else
                    targetLine.Visible = false
                end
            else
                targetLine.Visible = false
            end
        else
            targetLine.Visible = false
        end
    else
        targetLine.Visible = false
    end

    -- "manipulation" text below crosshair
    if updateManipulationText() then
        crosshairText.Visible = true
    else
        crosshairText.Visible = false
    end
end)

