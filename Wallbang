end)

local ShootEvent = ReplicatedStorage:WaitForChild("GunRemotes"):WaitForChild("ShootEvent")

do
    local installed = false
    local function handler(old, self, ...)
        if CFG.wallbang and rawequal(self, ShootEvent) then
            local okM, method = pcall(getnamecallmethod)
            if okM and method == "FireServer" then
                local rewritten = wallbangRewriteShots((...))
                if rewritten then
                    return old(self, rewritten, select(2, ...))
                end
            end
        end
        return old(self, ...)
    end
    if hookmetamethod and getrawmetatable then
        local previous
        pcall(function()
            local mt = getrawmetatable(game)
            if mt and type(mt.__namecall) == "function" then
                previous = mt.__namecall
            end
        end)
        if type(previous) == "function" then
            local old = previous
            local ok = pcall(function()
                local returned = hookmetamethod(game, "__namecall", safeWrap(function(self, ...)
                    return handler(old, self, ...)
                end))
                if type(returned) == "function" then old = returned end
            end)
            installed = ok
        end
    elseif getrawmetatable and setreadonly then
        pcall(function()
            local mt = getrawmetatable(game)
            local old = mt.__namecall
            if type(old) ~= "function" then return end
            if not pcall(setreadonly, mt, false) then return end
            mt.__namecall = safeWrap(function(self, ...)
                return handler(old, self, ...)
            end)
            pcall(setreadonly, mt, true)
            installed = true
        end)
    end
    if not installed then
        warn("[Wallbang] could not install the namecall hook - wallbang shots will not be rewritten")
    end
end

