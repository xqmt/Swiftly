local function safeWrap(fn)
    if newcclosure then
        local ok, w = pcall(newcclosure, fn)
        if ok and w then return w end
    end
    return fn
end

local partMap = {
    Torso = {"Torso", "UpperTorso", "LowerTorso"},
    LeftArm = {"Left Arm", "LeftUpperArm", "LeftLowerArm", "LeftHand"},
    RightArm = {"Right Arm", "RightUpperArm", "RightLowerArm", "RightHand"},
    LeftLeg = {"Left Leg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot"},
    RightLeg = {"Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot"},
}

local function getPart(char, name)
    if not char then return nil end
    local p = char:FindFirstChild(name)
    if p then return p end
    local alt = partMap[name]
    if alt then
        for _, n in ipairs(alt) do
            local part = char:FindFirstChild(n)
            if part then return part end
        end
    end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

local function getTargetPart(char)
    if not char then return nil end
    if CFG.shieldbreaker then
        local shield = char:FindFirstChild("RiotShieldPart")
        if shield and shield:IsA("BasePart") then
            local hp = shield:GetAttribute("Health")
            if hp and hp > 0 then
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local theirHrp = char:FindFirstChild("HumanoidRootPart")
                if myHrp and theirHrp then
                    local toMe = (myHrp.Position - theirHrp.Position).Unit
                    if toMe:Dot(theirHrp.CFrame.LookVector) > CFG.shieldfrontangle then
                        if CFG.shieldrandomhead and State.rng:NextInteger(1, 100) <= CFG.shieldheadchance then
                            return getPart(char, "Head")
                        end
                        return shield
                    end
                end
            end
        end
    end
    local partName
    if CFG.randomparts then
        local list = CFG.partslist
        partName = (list and #list > 0) and list[State.rng:NextInteger(1, #list)] or "Head"
    else
        partName = CFG.aimpart
    end
    return getPart(char, partName)
end

local function isDead(player)
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    return not hum or hum.Health <= 0
end

local function isStanding(player)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local v = hrp.AssemblyLinearVelocity
    return Vector2.new(v.X, v.Z).Magnitude <= CFG.stillthreshold
end

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.IgnoreWater = true
wallParams.RespectCanCollide = false
pcall(function() wallParams.CollisionGroup = "ClientBullet" end)

local function wallBetween(startPos, endPos, targetChar)
    local myChar = LocalPlayer.Character
    if not myChar then return true end
    wallParams.FilterDescendantsInstances = {myChar, targetChar}
    local direction = endPos - startPos
    local unit = direction.Unit
    local currentStart = startPos
    local remaining = direction.Magnitude
    for _ = 1, 10 do
        local result = workspace:Raycast(currentStart, unit * remaining, wallParams)
        if not result then return false end
        local hit = result.Instance
        if hit.Transparency < 0.8 and hit.CanCollide then return true end
        remaining = remaining - (result.Position - currentStart).Magnitude - 0.01
        if remaining <= 0 then return false end
        currentStart = result.Position + unit * 0.01
    end
    return false
end

local function quickCheck(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    if not getTargetPart(player.Character) then return false end
    if CFG.deathcheck and isDead(player) then return false end
    if CFG.ffcheck and player.Character:FindFirstChildOfClass("ForceField") then return false end
    if CFG.teamcheck and player.Team == LocalPlayer.Team then return false end
    if CFG.vehiclecheck then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart then return false end
    end
    if LocalPlayer.Team == Teams_.Criminals and player.Team == Teams_.Inmates then
        if CFG.criminalsTargetSuspectedInmates then
            local c = player.Character
            if not (c:GetAttribute("Hostile") or c:GetAttribute("Trespassing")) then return false end
        elseif CFG.criminalsnoinnmates then
            return false
        end
    end
    if LocalPlayer.Team == Teams_.Inmates and player.Team == Teams_.Criminals then
        if CFG.inmatesnocriminals and not CFG.inmatesTargetCriminals then return false end
    end
    if CFG.hostilecheck or CFG.trespasscheck then
        local gun = State.currentGun
        local isTaser = gun and gun:GetAttribute("Projectile") == "Taser"
        local bypassHostile = CFG.taserbypasshostile and isTaser
        local bypassTrespass = CFG.taserbypasstrespass and isTaser
        local c = player.Character
        if LocalPlayer.Team == Teams_.Guards and player.Team == Teams_.Inmates then
            local hostile = c:GetAttribute("Hostile")
            local trespass = c:GetAttribute("Trespassing")
            if CFG.hostilecheck and CFG.trespasscheck then
                if not bypassHostile and not bypassTrespass then
                    if not hostile and not trespass then return false end
                end
            elseif CFG.hostilecheck and not bypassHostile then
                if not hostile then return false end
            elseif CFG.trespasscheck and not bypassTrespass then
                if not trespass then return false end
            end
        end
    end
    return true
end

local function getAimTarget(player)
    local part = getTargetPart(player and player.Character)
    if not part then return nil, nil end
    return part, part.Position
end

local wallbangBlocked, wallbangResolve, wallbangRewriteShots

local function isValidTarget(player)
    if typeof(player) ~= "Instance" or not player:IsA("Player") then return false end
    if not quickCheck(player) then return false end
    if CFG.wallcheck then
        local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
        local part, targetPos = getAimTarget(player)
        if myHead and targetPos then
            if wallBetween(myHead.Position, targetPos, player.Character) then
                if CFG.wallbang and wallbangBlocked then
                    local ok, blocked = pcall(wallbangBlocked, myHead.Position, targetPos, part, player.Character)
                    if ok and not blocked then return true end
                end
                return false
            end
        end
    end
    return true
end

local function rollHit()
    local now = os.clock()
    if now - State.lastShotTime > 0.15 then
        State.lastShotTime = now
        local chance = CFG.hitchance
        if chance >= 100 then State.lastShotResult = true
        elseif chance <= 0 then State.lastShotResult = false
        else State.lastShotResult = State.rng:NextInteger(1, 100) <= chance end
    end
    return State.lastShotResult
end

local function getMissPos(targetPos)
    local spread = CFG.missspread
    local angle = State.rng:NextNumber() * math.pi * 2
    local d = State.rng:NextNumber() * spread
    local yOffset = (State.rng:NextNumber() - 0.5) * spread
    return targetPos + Vector3.new(math.cos(angle) * d, yOffset, math.sin(angle) * d)
end

local function getClosest(fovRadius)
    fovRadius = fovRadius or CFG.fov
    local camera = workspace.CurrentCamera
    if not camera then return nil, nil end
    local lastInput = UIS:GetLastInputType()
    local locked = (lastInput == Enum.UserInputType.Touch) or (UIS.MouseBehavior == Enum.MouseBehavior.LockCenter)
    local aimPos
    if locked then
        local vs = camera.ViewportSize
        aimPos = Vector2.new(vs.X / 2, vs.Y / 2)
    else
        aimPos = UIS:GetMouseLocation()
    end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local maxDist = tonumber(CFG.silentaimmaxdist) or 0
    local candidates = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if quickCheck(player) then
            local _, pos = getAimTarget(player)
            if pos then
                local sp, onScreen = camera:WorldToViewportPoint(pos)
                if onScreen and sp.Z > 0 then
                    local dist = (Vector2.new(sp.X, sp.Y) - aimPos).Magnitude
                    if dist < fovRadius then
                        local tooFar = maxDist > 0 and myRoot and (pos - myRoot.Position).Magnitude > maxDist
                        if not tooFar then
                            candidates[#candidates + 1] = {target = player, dist = dist, pos = pos}
                        end
                    end
                end
            end
        end
    end
    if CFG.prioritizeclosest then
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
    else
        for i = #candidates, 2, -1 do
            local j = State.rng:NextInteger(1, i)
            candidates[i], candidates[j] = candidates[j], candidates[i]
        end
    end
    for _, c in ipairs(candidates) do
        if isValidTarget(c.target) then
            return c.target, c.pos
        end
    end
    return nil, nil
end

local OriginScanner = {Cache = {}, Fail = {}, Offset = 0, Memory = setmetatable({}, {__mode = "k"})}
local rayParams = RaycastParams.new()
local overlapParams = OverlapParams.new()
pcall(function() rayParams.CollisionGroup = "ClientBullet" end)
rayParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() overlapParams.CollisionGroup = "ClientBullet" end)
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function checkPoint(pos, params)
    for _, part in ipairs(workspace:GetPartBoundsInRadius(pos, 0, params)) do
        if part.CanCollide and (part:GetClosestPointOnSurface(pos) - pos).Magnitude <= 0.0001 then
            return false
        end
    end
    return true
end

local scanOffsets = {
    Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(0.7, -0.5, -0.5),
    Vector3.new(-0.1, -0.8, -0.8), Vector3.new(-0.8, -0.5, -0.5), Vector3.new(-1, 0, 0),
    Vector3.new(-0.8, 0.4, 0.4), Vector3.new(0, 0.7, 0.7), Vector3.new(0.7, 0.5, 0.5),
    Vector3.new(1, 0, 0), Vector3.new(0.7, 0, -0.8), Vector3.new(-0.1, 0, -1),
    Vector3.new(-0.8, 0, -0.8), Vector3.new(-1, 0, 0), Vector3.new(-0.8, 0, 0.7),
    Vector3.new(0, 0, 1), Vector3.new(0.7, 0, 0.7), Vector3.new(1, 0, 0),
    Vector3.new(0.7, 0.4, -0.5), Vector3.new(-0.1, 0.7, -0.8), Vector3.new(-0.8, 0.4, -0.5),
    Vector3.new(-1, -0.1, 0), Vector3.new(-0.8, -0.5, 0.4), Vector3.new(0, -0.8, 0.7),
    Vector3.new(0.7, -0.6, 0.5), Vector3.new(0, -1, 0),
}

function OriginScanner:Scan(origin, target, extra, part, entityRoot)
    if self.Cache[part] then return table.unpack(self.Cache[part]) end
    if not entityRoot then return nil end
    local hitboxPositions = {}
    if checkPoint(target, overlapParams) then
        if extra and (origin - extra).Magnitude < 7.5 then
            self.Cache[part] = {extra}
            return extra
        end
        table.insert(hitboxPositions, target)
    end
    local scanPositions = {origin}
    local diff = CFrame.lookAt(origin * Vector3.new(1, 0, 1), target * Vector3.new(1, 0, 1)).LookVector
    for _, normal in ipairs(Enum.NormalId:GetEnumItems()) do
        local offset = Vector3.fromNormalId(normal)
        if (offset * Vector3.new(1, 0, 1)):Dot(-diff) > -0.5 then
            local pos = entityRoot.Position + offset * 7.4
            if checkPoint(pos, overlapParams) then
                table.insert(hitboxPositions, pos)
            end
        end
    end
    for _, offset in ipairs(scanOffsets) do
        if (offset * Vector3.new(1, 0, 1)):Dot(diff) > -0.5 then
            local pos = origin + offset * (7 - math.min(self.Offset, 1))
            if checkPoint(pos, overlapParams) then
                table.insert(scanPositions, pos)
            end
        end
    end
    local function try(hitboxes, scans)
        for _, hitbox in ipairs(hitboxes) do
            for _, pos in ipairs(scans) do
                local ray = workspace:Raycast(hitbox, (pos - hitbox), rayParams)
                if not ray then
                    self.Cache[part] = {pos, hitbox ~= target and hitbox or nil}
                    return pos, hitbox
                end
            end
        end
    end
    local p1, p2 = try(hitboxPositions, scanPositions)
    if p1 then return p1, p2 end
    local range = tonumber(CFG.wallbangrange) or 7
    if range > 7.5 and not self.Fail[part] then
        local now = os.clock()
        local mem = self.Memory[part]
        if mem and now - mem.t < (mem.fail and 0.2 or 0.06) then
            if mem.fail then
                self.Fail[part] = true
                return nil
            end
            local h = mem.hit or target
            if not workspace:Raycast(h, mem.pos - h, rayParams) then
                self.Cache[part] = {mem.pos, mem.hit}
                return mem.pos, mem.hit
            end
        end
        local deadline = now + 0.009
        local toTarget = target - origin
        local dist = toTarget.Magnitude
        local fwd = dist > 0.001 and toTarget.Unit or Vector3.new(0, 0, 1)
        local up = Vector3.new(0, 1, 0)
        local right = fwd:Cross(up)
        right = right.Magnitude > 0.001 and right.Unit or Vector3.new(1, 0, 0)
        local steps = math.clamp(math.ceil((range - 7) / 5) + 1, 2, 8)
        local radii = {}
        for i = 1, steps do
            radii[i] = 7 + (range - 7) * i / steps
        end
        local hbMax = 7.4 + math.min((range - 7) * 0.75, 30)
        local hbDirs = {}
        for _, normal in ipairs(Enum.NormalId:GetEnumItems()) do
            table.insert(hbDirs, Vector3.fromNormalId(normal))
        end
        for _, d in ipairs({Vector3.new(1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, 1), Vector3.new(-1, 0, -1)}) do
            table.insert(hbDirs, d.Unit)
        end
        local extHitboxes = {}
        if checkPoint(target, overlapParams) then
            table.insert(extHitboxes, target)
        end
        for _, r in ipairs({(7.4 + hbMax) / 2, hbMax}) do
            for _, d in ipairs(hbDirs) do
                local pos = entityRoot.Position + d * r
                if checkPoint(pos, overlapParams) then
                    table.insert(extHitboxes, pos)
                end
            end
        end
        local rootPos = entityRoot.Position
        local horizToMe = Vector3.new(origin.X - rootPos.X, 0, origin.Z - rootPos.Z)
        horizToMe = horizToMe.Magnitude > 0.001 and horizToMe.Unit or Vector3.new(0, 0, 1)
        if math.abs(target.Y - origin.Y) > 6 then
            for _, h in ipairs({3, 6, 10, 14}) do
                local up1 = rootPos + up * h
                if checkPoint(up1, overlapParams) then
                    table.insert(extHitboxes, up1)
                end
                for _, k in ipairs({3, 6, 10, 16}) do
                    local pos = rootPos + horizToMe * k + up * h
                    if checkPoint(pos, overlapParams) then
                        table.insert(extHitboxes, pos)
                    end
                end
            end
        end
        local extScans = {}
        local function addScan(pos)
            if #extScans < 260 and checkPoint(pos, overlapParams) then
                table.insert(extScans, pos)
            end
        end
        for _, r in ipairs(radii) do
            if r < dist then
                local base = origin + fwd * r
                addScan(base)
                addScan(base + up * 3)
                addScan(base - up * 3)
                addScan(base + right * 3)
                addScan(base - right * 3)
            end
        end
        if math.abs(target.Y - origin.Y) > 6 then
            local vdir = target.Y > origin.Y and 1 or -1
            local horizToTarget = Vector3.new(-horizToMe.X, 0, -horizToMe.Z)
            local horizDist = Vector3.new(target.X - origin.X, 0, target.Z - origin.Z).Magnitude
            for _, h in ipairs(radii) do
                for _, w in ipairs({0, 3, 6, math.min(horizDist, range * 0.5)}) do
                    addScan(origin + up * (vdir * h) + horizToTarget * math.min(w, horizDist))
                end
            end
        end
        local N = 34
        for _, r in ipairs(radii) do
            for i = 0, N - 1 do
                if os.clock() > deadline then break end
                local y = 1 - 2 * (i + 0.5) / N
                local rr = math.sqrt(math.max(0, 1 - y * y))
                local th = i * 2.399963
                addScan(origin + Vector3.new(math.cos(th) * rr, y, math.sin(th) * rr) * r)
            end
        end
        table.sort(extScans, function(a, b) return (a - target).Magnitude < (b - target).Magnitude end)
        local rays = 0
        for _, hitbox in ipairs(extHitboxes) do
            for _, pos in ipairs(extScans) do
                rays += 1
                if rays > 1600 or os.clock() > deadline then
                    self.Memory[part] = {t = os.clock(), fail = true}
                    self.Fail[part] = true
                    return nil
                end
                if not workspace:Raycast(hitbox, (pos - hitbox), rayParams) then
                    local hit = hitbox ~= target and hitbox or nil
                    self.Cache[part] = {pos, hit}
                    self.Memory[part] = {t = os.clock(), pos = pos, hit = hit}
                    return pos, hitbox
                end
            end
        end
        self.Memory[part] = {t = os.clock(), fail = true}
        self.Fail[part] = true
    end
    return nil
end

local lastIgnoreUpdate = 0

function OriginScanner:UpdateIgnore()
    lastIgnoreUpdate = os.clock()
    local ignoreList = {}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then table.insert(ignoreList, plr.Character) end
    end
    rayParams.FilterDescendantsInstances = ignoreList
    overlapParams.FilterDescendantsInstances = ignoreList
end

function OriginScanner:EnsureIgnore()
    if os.clock() - lastIgnoreUpdate > 0.5 then
        self:UpdateIgnore()
    end
end

local localPositions = {}
RunService.Heartbeat:Connect(function()
    pcall(function()
        table.clear(OriginScanner.Cache)
        table.clear(OriginScanner.Fail)
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            while true do
                local obj = localPositions[1]
                if obj and (os.clock() - obj[2]) > 0.1 then
                    table.remove(localPositions, 1)
                else
                    break
                end
            end
            table.insert(localPositions, {root.Position, os.clock()})
            OriginScanner.Offset = (root.Position - (localPositions[1] and localPositions[1][1] or root.Position)).Magnitude
        else
            table.clear(localPositions)
        end
    end)
end)

function wallbangBlocked(origin, position, part, character)
    OriginScanner:EnsureIgnore()
    local ray = workspace:Raycast(position, (origin - position), rayParams)
    if ray or workspace:Raycast(origin, (position - origin), rayParams) then
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root or not myRoot then return true end
        part = part or root
        return not OriginScanner:Scan(myRoot.Position, position, ray and ray.Position + ray.Normal * 0.01 or nil, part, root)
    end
    return false
end

function wallbangResolve(startPos, aimPos, targetPart)
    if not (CFG.wallbang and startPos and aimPos and targetPart) then return nil end
    local okAll, newOrigin, hit = pcall(function()
        OriginScanner:EnsureIgnore()
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local targetRoot = targetPart.Parent and (targetPart.Parent:FindFirstChild("HumanoidRootPart") or targetPart)
        if not myRoot or not targetRoot then return nil end
        local ray
        if not OriginScanner.Cache[targetPart] then
            ray = workspace:Raycast(aimPos, (startPos - aimPos), rayParams)
        end
        if OriginScanner.Cache[targetPart] or ray or workspace:Raycast(startPos, (aimPos - startPos), rayParams) then
            return OriginScanner:Scan(myRoot.Position, aimPos, ray and ray.Position + ray.Normal * 0.01 or nil, targetPart, targetRoot)
        end
        return nil
    end)
    if okAll and newOrigin then return newOrigin, hit end
    return nil
end

local wallbangPending = nil

function wallbangRewriteShots(shots)
    local pending = wallbangPending
    if not (pending and CFG.wallbang and CFG.enabled) then return nil end
    if os.clock() - pending.t > 0.6 then
        wallbangPending = nil
        return nil
    end
    if type(shots) ~= "table" then return nil end
    local out, changed = {}, false
    for i, shot in pairs(shots) do
        if type(shot) == "table" and shot[3] ~= nil and shot[3] == pending.part then
            local copy = {}
            for k, v in pairs(shot) do copy[k] = v end
            copy[1] = pending.origin
            if pending.hit then copy[2] = pending.hit end
            out[i] = copy
            changed = true
        else
            out[i] = shot
        end
    end
    if changed then return out end
    return nil
end

